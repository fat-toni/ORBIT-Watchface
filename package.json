{
  "name": "orbit-watchface",
  "version": "1.1.0",
  "description": "ORBIT: calm digital watchface for square Amazfit watches with Zepp OS 3+ (Bip 6, Active 2 Square, GTS 4, Active, Cheetah Square)",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "test": "node --import ./test/mock/setup.mjs --test test/*.test.mjs",
    "assets": "python3 tools/make_assets.py",
    "format": "prettier --write \"**/*.{js,mjs}\"",
    "check": "prettier --check \"**/*.{js,mjs}\" && npm test",
    "build": "bash tools/build.sh",
    "release-check": "node tools/release_check.mjs"
  },
  "author": "Toni",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@zeppos/device-types": "^3.0.0",
    "prettier": "^3.3.3"
  }
}
